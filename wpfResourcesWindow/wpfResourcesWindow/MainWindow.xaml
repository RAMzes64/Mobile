<Window x:Class="wpfResourcesWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfResourcesWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="300">
    <Window.Resources>
        <SolidColorBrush x:Key="Background_play" Color="LightGreen"/>
        <SolidColorBrush x:Key="Background_stop" Color="LightPink"/>
    </Window.Resources>
    <StackPanel>
        <Button Content="111" Background="LightBlue"/>
        <Button Content="222" Background="LightCoral"/> 
        <Button Content="Play" Background="{StaticResource Background_play}"/>
        <Button Content="Play 22" Background="{DynamicResource Background_play}"/>
        <Button Content="Change Background_play" Click="Button_Click"/>
        <Button Content="Change Background_play 222" x:Name="buChange"/>
    </StackPanel>
</Window>
