<Window x:Class="wpfTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfTemplate"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="300">
    <Window.Resources>
        <ControlTemplate x:Key="tmp_button_1" TargetType="Button">
            <Border Height="50" Background="LightCoral" CornerRadius="20">
                <ContentControl Content="{TemplateBinding Content}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="FontSize" Value="40"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="False">
                    <Setter Property="FontSize" Value="10"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <StackPanel>
        <Button Content="111"/>
        <Button Content="222"/>
        <Button Content="333" Template="{StaticResource tmp_button_1}"/>

        <ListBox x:Name="lbPhones"/>

        <ListBox x:Name="lbTasks">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="20"/>
                        <TextBlock Text="{Binding Description }"/>
                        <TextBlock Text="{Binding Priority }"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Background="LightGreen" x:Name="stackPanelAdd">
            <TextBox Text="{Binding Path=Name}"/>
            <TextBox Text="{Binding Path=Description}"/>
            <TextBox Text="{Binding Path=Priority}"/>
            <Button Content="Add" Click="Button_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
