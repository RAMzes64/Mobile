<Window x:Class="FairyChess.Wpf.Views.PieceTypeEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый тип фигуры" Width="540" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Имя / символ / превращение -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Имя:" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Margin="4,4,10,4"/>
            <TextBlock Text="Символ:" Grid.Column="2" VerticalAlignment="Center"/>
            <TextBox x:Name="SymbolBox" Grid.Column="3" Margin="4"/>
            <TextBlock Text="Превращение:" Grid.Column="4" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ComboBox x:Name="PromotesToBox" Grid.Column="5" Margin="4"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,6">
            <CheckBox x:Name="IsRoyalCheck" Content="Королевская (шах/мат)" Margin="0,0,16,0"/>
            <CheckBox x:Name="DoubleFirstCheck" Content="Двойной первый ход"/>
        </StackPanel>

        <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,4"
                   Text="Шаблоны ходов: dx, dy — смещение; maxSteps — длина скольжения (1 = прыжок); mirror — все 8 симметрий."/>

        <DockPanel Grid.Row="3">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Добавить шаблон" Click="AddPattern" Width="130" Margin="0,0,8,0"/>
                <Button Content="Удалить выбранный" Click="RemovePattern" Width="140"/>
            </StackPanel>
            <DataGrid x:Name="PatternsGrid" ItemsSource="{Binding Patterns}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="dx" Binding="{Binding Dx}"/>
                    <DataGridTextColumn Header="dy" Binding="{Binding Dy}"/>
                    <DataGridTextColumn Header="maxSteps" Binding="{Binding MaxSteps}"/>
                    <DataGridCheckBoxColumn Header="mirror" Binding="{Binding Mirror}"/>
                    <DataGridCheckBoxColumn Header="только взятие" Binding="{Binding CaptureOnly}"/>
                    <DataGridCheckBoxColumn Header="только тихий" Binding="{Binding QuietOnly}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Click="OkClick" Width="90" IsDefault="True"/>
            <Button Content="Отмена" Width="90" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>