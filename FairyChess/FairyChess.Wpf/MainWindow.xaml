<Window x:Class="FairyChess.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FairyChess.Wpf.ViewModels"
        Title="Сказочные шахматы" Height="720" Width="1160" MinWidth="860" MinHeight="600">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- Доска -->
        <Border Grid.Column="0" BorderBrush="#888888" BorderThickness="1" Margin="0,0,10,0">
            <ItemsControl ItemsSource="{Binding Squares}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding DataContext.BoardRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     Columns="{Binding DataContext.BoardColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SquareViewModel}">
                        <Button ToolTip="{Binding Coordinates}"
                                Command="{Binding DataContext.SquareClickCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="0" Focusable="False">
                            <TextBlock Text="{Binding Symbol}" FontWeight="Bold"
                                       Foreground="{Binding PieceBrush}"
                                       FontSize="{Binding DataContext.SquareFontSize, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F0D9B5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Background" Value="#B58863"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLegalTarget}" Value="True">
                                            <Setter Property="Background" Value="#7DBB63"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#F5C242"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Правая панель -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="Партия">
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding TurnText}" FontSize="13" Margin="0,2,0,6"/>
                        <WrapPanel>
                            <Button Content="Отменить ход" Command="{Binding UndoCommand}" Padding="8,4" Margin="0,0,6,4"/>
                            <Button Content="Белые сдаются" Command="{Binding ResignWhiteCommand}" Padding="8,4" Margin="0,0,6,4"/>
                            <Button Content="Чёрные сдаются" Command="{Binding ResignBlackCommand}" Padding="8,4" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <Button Content="Новая партия (к расстановке)" Command="{Binding NewGameCommand}"
                                Padding="8,4" HorizontalAlignment="Left"/>
                        <ListBox ItemsSource="{Binding MoveHistory}" Height="130" Margin="0,8,0,0"
                                 FontFamily="Consolas"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Расстановка" Margin="0,8,0,0" IsEnabled="{Binding IsSetupMode}">
                    <StackPanel Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Мин. X:" VerticalAlignment="Center" Margin="0,0,4,2"/>
                            <TextBox Text="{Binding MinXText, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,0,8,2"/>
                            <TextBlock Text="Мин. Y:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,4,2"/>
                            <TextBox Text="{Binding MinYText, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" Margin="0,0,0,2"/>

                            <TextBlock Text="Ширина:" Grid.Row="1" VerticalAlignment="Center" Margin="0,2,4,2"/>
                            <TextBox Text="{Binding BoardWidthText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2"/>
                            <TextBlock Text="Высота:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,2,4,2"/>
                            <TextBox Text="{Binding BoardHeightText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3" Margin="0,2,0,2"/>
                        </Grid>

                        <TextBlock Text="Клик по доске — поставить выбранную фигуру или убрать стоящую."
                                   TextWrapping="Wrap" FontSize="11" Foreground="#555555" Margin="0,6,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Фигура:" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <ComboBox ItemsSource="{Binding PieceTypes}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedPieceType}" Grid.Column="1" Margin="0,0,0,4"/>

                            <TextBlock Text="Цвет:" Grid.Row="1" VerticalAlignment="Center" Margin="0,2,6,4"/>
                            <ComboBox ItemsSource="{Binding PieceColors}"
                                      SelectedItem="{Binding SelectedPieceColor}" Grid.Row="1" Grid.Column="1" Margin="0,2,0,4"/>
                        </Grid>

                        <Button Content="Начать партию" Command="{Binding StartGameCommand}"
                                FontSize="14" Padding="10,6" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Типы фигур (динамически)" Margin="0,8,0,0">
                    <StackPanel Margin="4">
                        <Button Content="Создать новый тип..." Command="{Binding AddPieceTypeCommand}"
                                Padding="8,4" Margin="0,0,0,6" HorizontalAlignment="Left"/>
                        <Button Content="Загрузить типы из JSON..." Command="{Binding LoadTypesCommand}"
                                Padding="8,4" HorizontalAlignment="Left"/>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="{Binding Message}" Foreground="Firebrick" TextWrapping="Wrap"
                           Margin="4,10,4,0" MinHeight="32"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>