<Window x:Class="ImageAlignmentDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ImageAlignmentDesktop" 
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <local:MatConverter x:Key="MatToBitmapConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="LightGray" Margin="2">
            <Button x:Name="FileButton" Content="Файл" Margin="4" Padding="6,2"
            Tag="{Binding Text, ElementName=PathTextBox}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Открыть" 
                            Command="{Binding PlacementTarget.DataContext.LoadImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Сохранить"
                             Command="{Binding PlacementTarget.DataContext.SaveImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>

        <StackPanel Grid.Column="0" Background="WhiteSmoke" Width="170" Margin="2">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="Панель управления" FontWeight="Bold" Margin="4"/>

            <TextBlock Text="Толщина контура:" Margin="4,8,4,2"/>
            <TextBox x:Name="ThicknessBox" Text="{Binding CurrentDocument.DetectionParams.Thickness, Mode=TwoWay}" Margin="4,0,4,4" Width="80" HorizontalAlignment="Left"/>

            <TextBlock Text="Цвет объекта:" Margin="4,8,4,2"/>
            <ComboBox ItemsSource="{Binding AvailableColors}"
                      DisplayMemberPath="Key"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding CurrentDocument.DetectionParams.Color, Mode=TwoWay}"
                      Width="130" 
                      Height="25"
                      Margin="5" 
                      VerticalAlignment="Center"
                      ToolTip="Выберите цвет контура"/>

            <Separator Margin="4,10"/>

            <Button Content="Применить поворот" Command="{Binding RotateCommand}" Margin="4,2" Padding="5"/>
            <Button Content="Выделить объект" Command="{Binding DetectCommand}" Margin="4,2" Padding="5"/>
            <Button Content="Обрезать объект" Command="{Binding DetectAndCropCommand}" Margin="4,2" Padding="5"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="4,10,4,4" TextWrapping="Wrap" FontSize="11"/>
        
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Background="LightGray" Height="60" Margin="2">
            <Grid>
                <Slider x:Name="MainSlider"
                        Minimum="-180" Maximum="180" 
                        Value="{Binding CurrentDocument.Angle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        TickPlacement="BottomRight"
                        VerticalAlignment="Center"
                        AutoToolTipPlacement="TopLeft"
                        AutoToolTipPrecision="0"/>

                <TextBlock Text="-180" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,2" FontSize="10"/>
                <TextBlock Text="{Binding CurrentDocument.Angle, StringFormat='Угол: {0}°'}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" FontWeight="Bold"/>
                <TextBlock Text="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10" Margin="0,0,0,2"/>
                <TextBlock Text="180" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2" FontSize="10"/>
            </Grid>
        </DockPanel>

        <Grid>
            <Image Name="MainImage" 
                   Source="{Binding CurrentDocument.DisplayMat, Converter={StaticResource MatToBitmapConverter}, FallbackValue={x:Null}}"
                   Stretch="Uniform" 
                   ToolTip="Выберите файл через меню Файл -> Открыть"/>

            <Border Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="Обработка изображения..." Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
